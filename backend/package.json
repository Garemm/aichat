{
  "name": "llm-chat-backend",
  "version": "1.0.0",
  "description": "Real-time messaging backend — Express + Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/temp/**",
      "!src/config/schema.sql"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 60
      }
    },
    "coverageReporters": ["text", "lcov", "html"],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "verbose": true
  },
  "dependencies": {
    "compromise": "^14.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.20.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
